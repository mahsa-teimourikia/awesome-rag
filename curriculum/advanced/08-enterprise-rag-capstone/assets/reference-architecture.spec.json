{
  "version": 2,
  "id": "enterprise-rag-reference-architecture",
  "title": "Northstar Enterprise RAG reference architecture",
  "subtitle": "Identity constrains evidence; adaptive and corrective control earn complexity per request.",
  "alt_text": "A left-to-right enterprise RAG architecture from an authenticated request through authorization, routing, evidence systems, quality control, an evidence ledger, validation, and observability.",
  "output": "reference-architecture.svg",
  "canvas": {"width": 1600, "height": 900, "background": "#F7F9FC", "margin": 60, "grid": 10},
  "style": {"font_family": "Inter, Arial, sans-serif", "title_color": "#16324F", "connector_color": "#52606D", "semantic_colors": {"service": {"fill": "#EAF1FF", "stroke": "#2F6BFF"}, "agent": {"fill": "#F0EEFF", "stroke": "#7667E8"}, "data": {"fill": "#E5F7F6", "stroke": "#16A3A5"}, "action": {"fill": "#FFF1DF", "stroke": "#F59E42"}, "operations": {"fill": "#FFFFFF", "stroke": "#8A98A8"}, "danger": {"fill": "#FFF0F0", "stroke": "#D64545"}}},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 60, "min_layer_gap": 80},
  "groups": [
    {"id": "control", "label": "Control plane", "x": 300, "y": 150, "width": 620, "height": 230, "fill": "#FBFCFF"},
    {"id": "evidence", "label": "Evidence plane", "x": 300, "y": 450, "width": 720, "height": 360, "fill": "#FBFFFE"},
    {"id": "assurance", "label": "Assurance plane", "x": 1100, "y": 150, "width": 430, "height": 660, "fill": "#FFFDFC"}
  ],
  "nodes": [
    {"id": "request", "label": "Authenticated request", "type": "service", "x": 70, "y": 220, "width": 190, "height": 100, "ports": {"out": {"side": "right"}}},
    {"id": "identity", "group": "control", "label": "Identity + authorization", "type": "action", "x": 340, "y": 215, "width": 220, "height": 110, "ports": {"in": {"side": "left"}, "out": {"side": "right"}, "evidence": {"side": "bottom", "offset": 0.35}}},
    {"id": "router", "group": "control", "label": "Requirement analysis + route", "type": "agent", "x": 650, "y": 215, "width": 230, "height": 110, "ports": {"in": {"side": "left"}, "out": {"side": "bottom"}}},
    {"id": "sources", "group": "evidence", "label": "Text · SQL · Graph · OCR · External", "type": "data", "x": 340, "y": 535, "width": 280, "height": 120, "ports": {"auth": {"side": "top", "offset": 0.3}, "route": {"side": "top", "offset": 0.7}, "out": {"side": "right"}}},
    {"id": "quality", "group": "evidence", "label": "Evidence quality + correction", "type": "agent", "x": 720, "y": 535, "width": 260, "height": 120, "ports": {"in": {"side": "left"}, "out": {"side": "right"}, "recover": {"side": "bottom"}}},
    {"id": "agent", "group": "evidence", "label": "Bounded investigation", "type": "agent", "x": 720, "y": 720, "width": 260, "height": 70, "ports": {"in": {"side": "top"}, "out": {"side": "right"}}},
    {"id": "ledger", "group": "assurance", "label": "Evidence ledger", "type": "data", "x": 1150, "y": 220, "width": 300, "height": 85, "ports": {"quality": {"side": "left", "offset": 0.35294117647058826}, "agent": {"side": "left", "offset": 0.7058823529411765}, "down": {"side": "bottom"}}},
    {"id": "answer", "group": "assurance", "label": "Answer · clarify · abstain", "type": "service", "x": 1150, "y": 355, "width": 300, "height": 95, "ports": {"in": {"side": "top"}, "out": {"side": "bottom"}}},
    {"id": "validation", "group": "assurance", "label": "Claim + policy validation", "type": "action", "x": 1150, "y": 500, "width": 300, "height": 95, "ports": {"in": {"side": "top"}, "out": {"side": "bottom"}}},
    {"id": "observability", "group": "assurance", "label": "Trace · evaluate · release", "type": "operations", "x": 1150, "y": 650, "width": 300, "height": 85, "ports": {"in": {"side": "top"}}}
  ],
  "edges": [
    {"id": "e1", "from": {"node": "request", "port": "out"}, "to": {"node": "identity", "port": "in"}},
    {"id": "e2", "from": {"node": "identity", "port": "out"}, "to": {"node": "router", "port": "in"}},
    {"id": "e3", "from": {"node": "identity", "port": "evidence"}, "to": {"node": "sources", "port": "auth"}, "route": [[417, 410], [424, 410]], "label": "eligible universe", "label_at": [510, 410], "label_width": 132},
    {"id": "e4", "from": {"node": "router", "port": "out"}, "to": {"node": "sources", "port": "route"}, "route": [[765, 440], [536, 440]]},
    {"id": "e5", "from": {"node": "sources", "port": "out"}, "to": {"node": "quality", "port": "in"}},
    {"id": "e6", "from": {"node": "quality", "port": "recover"}, "to": {"node": "agent", "port": "in"}, "label": "only if justified", "label_at": [850, 688], "label_width": 132},
    {"id": "e7", "from": {"node": "quality", "port": "out"}, "to": {"node": "ledger", "port": "quality"}, "route": [[1050, 595], [1050, 250]]},
    {"id": "e8", "from": {"node": "agent", "port": "out"}, "to": {"node": "ledger", "port": "agent"}, "route": [[1070, 755], [1070, 280]]},
    {"id": "e9", "from": {"node": "ledger", "port": "down"}, "to": {"node": "answer", "port": "in"}},
    {"id": "e10", "from": {"node": "answer", "port": "out"}, "to": {"node": "validation", "port": "in"}},
    {"id": "e11", "from": {"node": "validation", "port": "out"}, "to": {"node": "observability", "port": "in"}}
  ],
  "validation": {"no_overlaps": true, "route_around_nodes": true, "min_text_padding": 16, "min_connector_clearance": 8, "verify_port_attachment": true, "verify_contrast": true}
}
