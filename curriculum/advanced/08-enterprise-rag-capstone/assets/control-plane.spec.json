{
  "version": 2,
  "id": "control-plane",
  "title": "Adaptive, corrective, and agentic control are separate decisions",
  "subtitle": "A route proposal never grants authority; every recovery is bounded and re-evaluated.",
  "alt_text": "A control flow from a query through requirements, route proposal, policy authorization, evidence execution, quality assessment, bounded recovery, and a terminal response; a trusted principal independently constrains policy.",
  "output": "control-plane.svg",
  "canvas": {"width": 1600, "height": 900, "background": "#F7F9FC", "margin": 60, "grid": 10},
  "style": {"font_family": "Inter, Arial, sans-serif", "title_color": "#16324F", "connector_color": "#52606D", "semantic_colors": {"service": {"fill": "#EAF1FF", "stroke": "#2F6BFF"}, "agent": {"fill": "#F0EEFF", "stroke": "#7667E8"}, "data": {"fill": "#E5F7F6", "stroke": "#16A3A5"}, "action": {"fill": "#FFF1DF", "stroke": "#F59E42"}, "operations": {"fill": "#FFFFFF", "stroke": "#8A98A8"}, "danger": {"fill": "#FFF0F0", "stroke": "#D64545"}}},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 60, "min_layer_gap": 90},
  "nodes": [
    {"id": "query", "label": "Query", "type": "service", "x": 70, "y": 220, "width": 170, "height": 90, "ports": {"out": {"side": "right"}}},
    {"id": "requirements", "label": "Requirement packet", "type": "agent", "x": 320, "y": 220, "width": 210, "height": 90, "ports": {"in": {"side": "left"}, "out": {"side": "right"}}},
    {"id": "proposal", "label": "Route proposal", "type": "agent", "x": 610, "y": 220, "width": 190, "height": 90, "ports": {"in": {"side": "left"}, "out": {"side": "right"}}},
    {"id": "policy", "label": "Policy decision", "subtitle": "identity · route · budget", "type": "action", "x": 890, "y": 210, "width": 240, "height": 110, "ports": {"route": {"side": "left"}, "principal": {"side": "bottom", "offset": 0.3}, "recovery": {"side": "bottom", "offset": 0.7}, "out": {"side": "right"}}},
    {"id": "execute", "label": "Execute evidence route", "type": "data", "x": 1240, "y": 220, "width": 250, "height": 90, "ports": {"in": {"side": "left"}, "out": {"side": "bottom"}}},
    {"id": "principal", "label": "Trusted principal", "subtitle": "authenticated attributes", "type": "action", "x": 70, "y": 470, "width": 200, "height": 90, "wrap": 20, "ports": {"out": {"side": "right"}}},
    {"id": "recovery", "label": "Bounded correction / investigation", "type": "agent", "x": 760, "y": 480, "width": 280, "height": 100, "ports": {"in": {"side": "right"}, "out": {"side": "top", "offset": 0.75}}},
    {"id": "quality", "label": "Evidence sufficient?", "type": "agent", "x": 1240, "y": 480, "width": 250, "height": 100, "ports": {"in": {"side": "top"}, "no": {"side": "left"}, "yes": {"side": "bottom"}}},
    {"id": "terminal", "label": "Answer · clarify · abstain · approval", "type": "service", "x": 1240, "y": 700, "width": 250, "height": 100, "ports": {"in": {"side": "top"}}}
  ],
  "edges": [
    {"id": "q1", "from": {"node": "query", "port": "out"}, "to": {"node": "requirements", "port": "in"}},
    {"id": "q2", "from": {"node": "requirements", "port": "out"}, "to": {"node": "proposal", "port": "in"}},
    {"id": "q3", "from": {"node": "proposal", "port": "out"}, "to": {"node": "policy", "port": "route"}},
    {"id": "q4", "from": {"node": "principal", "port": "out"}, "to": {"node": "policy", "port": "principal"}, "route": [[560, 515], [560, 400], [962, 400]], "label": "trusted scope", "label_at": [690, 400], "label_width": 112},
    {"id": "q5", "from": {"node": "policy", "port": "out"}, "to": {"node": "execute", "port": "in"}},
    {"id": "q6", "from": {"node": "execute", "port": "out"}, "to": {"node": "quality", "port": "in"}},
    {"id": "q7", "from": {"node": "quality", "port": "no"}, "to": {"node": "recovery", "port": "in"}, "label": "weak / insufficient", "label_at": [1140, 530], "label_width": 150},
    {"id": "q8", "from": {"node": "recovery", "port": "out"}, "to": {"node": "policy", "port": "recovery"}, "route": [[970, 430], [1058, 430]], "label": "re-authorize", "label_at": [1014, 445], "label_width": 112},
    {"id": "q9", "from": {"node": "quality", "port": "yes"}, "to": {"node": "terminal", "port": "in"}, "label": "strong", "label_at": [1425, 640], "label_width": 88}
  ],
  "validation": {"no_overlaps": true, "route_around_nodes": true, "min_text_padding": 16, "min_connector_clearance": 8, "verify_port_attachment": true, "verify_contrast": true}
}
