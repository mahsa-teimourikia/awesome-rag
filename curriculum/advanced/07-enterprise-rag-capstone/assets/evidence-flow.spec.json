{
  "version": 2,
  "id": "evidence-flow",
  "title": "One evidence contract across heterogeneous sources",
  "subtitle": "Normalization preserves modality, kind, authority, version, locator, tenancy, and derivation.",
  "alt_text": "Six source-specific evidence types flow through adapters into a common Evidence contract, then quality validation, an evidence ledger, and claim-linked answers.",
  "output": "evidence-flow.svg",
  "canvas": {"width": 1600, "height": 900, "background": "#F7F9FC", "margin": 60, "grid": 10},
  "style": {"font_family": "Inter, Arial, sans-serif", "title_color": "#16324F", "connector_color": "#52606D", "semantic_colors": {"service": {"fill": "#EAF1FF", "stroke": "#2F6BFF"}, "agent": {"fill": "#F0EEFF", "stroke": "#7667E8"}, "data": {"fill": "#E5F7F6", "stroke": "#16A3A5"}, "action": {"fill": "#FFF1DF", "stroke": "#F59E42"}, "operations": {"fill": "#FFFFFF", "stroke": "#8A98A8"}, "danger": {"fill": "#FFF0F0", "stroke": "#D64545"}}},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 40, "min_layer_gap": 80},
  "groups": [
    {"id": "inputs", "label": "Source evidence", "x": 70, "y": 140, "width": 540, "height": 680, "fill": "#FBFFFE"},
    {"id": "contract", "label": "Shared evidence plane", "x": 650, "y": 140, "width": 880, "height": 680, "fill": "#FBFCFF"}
  ],
  "nodes": [
    {"id": "text", "group": "inputs", "label": "Text chunk", "type": "data", "x": 110, "y": 195, "width": 260, "height": 70, "ports": {"out": {"side": "right"}}},
    {"id": "row", "group": "inputs", "label": "Database row", "type": "data", "x": 110, "y": 295, "width": 260, "height": 70, "ports": {"out": {"side": "right"}}},
    {"id": "edge", "group": "inputs", "label": "Graph relation", "type": "data", "x": 110, "y": 395, "width": 260, "height": 70, "ports": {"out": {"side": "right"}}},
    {"id": "ocr", "group": "inputs", "label": "OCR region", "type": "data", "x": 110, "y": 495, "width": 260, "height": 70, "ports": {"out": {"side": "right"}}},
    {"id": "visual", "group": "inputs", "label": "Visual observation", "type": "data", "x": 110, "y": 595, "width": 260, "height": 70, "ports": {"out": {"side": "right"}}},
    {"id": "external", "group": "inputs", "label": "Approved external item", "type": "data", "x": 110, "y": 695, "width": 260, "height": 70, "ports": {"out": {"side": "right"}}},
    {"id": "normalize", "group": "contract", "label": "Source-specific adapters", "subtitle": "Normalize without losing provenance", "type": "agent", "x": 700, "y": 195, "width": 230, "height": 570, "ports": {"text": {"side": "left", "offset": 0.06140350877192982}, "row": {"side": "left", "offset": 0.23684210526315788}, "edge": {"side": "left", "offset": 0.41228070175438597}, "ocr": {"side": "left", "offset": 0.5877192982456141}, "visual": {"side": "left", "offset": 0.7631578947368421}, "external": {"side": "left", "offset": 0.9385964912280702}, "out": {"side": "right"}}},
    {"id": "contract_node", "group": "contract", "label": "Evidence contract", "subtitle": "observed · computed · inferred", "type": "agent", "x": 1010, "y": 250, "width": 240, "height": 130, "ports": {"in": {"side": "left"}, "down": {"side": "bottom"}}},
    {"id": "quality", "group": "contract", "label": "Eligibility + quality", "type": "action", "x": 1010, "y": 500, "width": 240, "height": 100, "ports": {"in": {"side": "top"}, "out": {"side": "right"}}},
    {"id": "ledger", "group": "contract", "label": "Evidence ledger", "type": "data", "x": 1310, "y": 500, "width": 190, "height": 100, "ports": {"in": {"side": "left"}, "out": {"side": "top"}}},
    {"id": "claims", "group": "contract", "label": "Claims cite evidence IDs", "type": "service", "x": 1310, "y": 250, "width": 190, "height": 130, "ports": {"in": {"side": "bottom"}}}
  ],
  "edges": [
    {"id": "t", "from": {"node": "text", "port": "out"}, "to": {"node": "normalize", "port": "text"}},
    {"id": "r", "from": {"node": "row", "port": "out"}, "to": {"node": "normalize", "port": "row"}},
    {"id": "g", "from": {"node": "edge", "port": "out"}, "to": {"node": "normalize", "port": "edge"}},
    {"id": "o", "from": {"node": "ocr", "port": "out"}, "to": {"node": "normalize", "port": "ocr"}},
    {"id": "v", "from": {"node": "visual", "port": "out"}, "to": {"node": "normalize", "port": "visual"}},
    {"id": "x", "from": {"node": "external", "port": "out"}, "to": {"node": "normalize", "port": "external"}},
    {"id": "nc", "from": {"node": "normalize", "port": "out"}, "to": {"node": "contract_node", "port": "in"}, "route": [[970, 480], [970, 315]]},
    {"id": "cq", "from": {"node": "contract_node", "port": "down"}, "to": {"node": "quality", "port": "in"}},
    {"id": "ql", "from": {"node": "quality", "port": "out"}, "to": {"node": "ledger", "port": "in"}},
    {"id": "lc", "from": {"node": "ledger", "port": "out"}, "to": {"node": "claims", "port": "in"}}
  ],
  "validation": {"no_overlaps": true, "route_around_nodes": true, "min_text_padding": 16, "min_connector_clearance": 8, "verify_port_attachment": true, "verify_contrast": true}
}
