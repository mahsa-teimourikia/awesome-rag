{
  "version": 2,
  "id": "incident-lifecycle",
  "title": "RAG incident lifecycle",
  "subtitle": "Restore a safe state first; preserve evidence; convert the failure into a permanent test.",
  "alt_text": "An incident lifecycle from detection and classification through containment, investigation, rollback or fix, verification, regression testing, postmortem, and monitoring that feeds new signals back into detection.",
  "output": "incident-lifecycle.svg",
  "canvas": {"width": 1600, "height": 900, "background": "#F7F9FC", "margin": 60, "grid": 10},
  "style": {"font_family": "Inter, Arial, sans-serif", "title_color": "#16324F", "connector_color": "#52606D", "semantic_colors": {"service": {"fill": "#EAF1FF", "stroke": "#2F6BFF"}, "agent": {"fill": "#F0EEFF", "stroke": "#7667E8"}, "data": {"fill": "#E5F7F6", "stroke": "#16A3A5"}, "action": {"fill": "#FFF1DF", "stroke": "#F59E42"}, "operations": {"fill": "#FFFFFF", "stroke": "#8A98A8"}, "danger": {"fill": "#FFF0F0", "stroke": "#D64545"}}},
  "layout": {"primary_flow": "left-to-right then down", "min_node_gap": 70, "min_layer_gap": 120},
  "nodes": [
    {"id": "detect", "label": "Detect", "subtitle": "signal + impact", "type": "danger", "x": 70, "y": 220, "width": 180, "height": 100, "ports": {"loop": {"side": "left", "offset": 0.7}, "out": {"side": "right"}}},
    {"id": "classify", "label": "Classify", "subtitle": "quality · safety · ops", "type": "action", "x": 330, "y": 220, "width": 200, "height": 100, "ports": {"in": {"side": "left"}, "out": {"side": "right"}}},
    {"id": "contain", "label": "Contain", "subtitle": "disable route · rollback", "type": "danger", "x": 620, "y": 220, "width": 210, "height": 100, "ports": {"in": {"side": "left"}, "out": {"side": "right"}}},
    {"id": "investigate", "label": "Investigate", "subtitle": "trace + versions", "type": "agent", "x": 920, "y": 220, "width": 200, "height": 100, "ports": {"in": {"side": "left"}, "out": {"side": "right"}}},
    {"id": "fix", "label": "Rollback or fix", "subtitle": "compatible safe state", "type": "action", "x": 1210, "y": 220, "width": 240, "height": 100, "ports": {"in": {"side": "left"}, "out": {"side": "bottom"}}},
    {"id": "verify", "label": "Verify recovery", "subtitle": "hard invariants first", "type": "service", "x": 1210, "y": 500, "width": 240, "height": 100, "ports": {"in": {"side": "top"}, "out": {"side": "left"}}},
    {"id": "regression", "label": "Add regression case", "subtitle": "reproduce root cause", "type": "data", "x": 850, "y": 500, "width": 240, "height": 100, "ports": {"in": {"side": "right"}, "out": {"side": "left"}}},
    {"id": "postmortem", "label": "Postmortem + control update", "type": "operations", "x": 460, "y": 500, "width": 270, "height": 100, "ports": {"in": {"side": "right"}, "out": {"side": "bottom"}}},
    {"id": "monitor", "label": "Monitor the changed control", "type": "operations", "x": 460, "y": 700, "width": 270, "height": 80, "ports": {"in": {"side": "top"}, "loop": {"side": "left"}}}
  ],
  "edges": [
    {"id": "i1", "from": {"node": "detect", "port": "out"}, "to": {"node": "classify", "port": "in"}},
    {"id": "i2", "from": {"node": "classify", "port": "out"}, "to": {"node": "contain", "port": "in"}},
    {"id": "i3", "from": {"node": "contain", "port": "out"}, "to": {"node": "investigate", "port": "in"}},
    {"id": "i4", "from": {"node": "investigate", "port": "out"}, "to": {"node": "fix", "port": "in"}},
    {"id": "i5", "from": {"node": "fix", "port": "out"}, "to": {"node": "verify", "port": "in"}},
    {"id": "i6", "from": {"node": "verify", "port": "out"}, "to": {"node": "regression", "port": "in"}},
    {"id": "i7", "from": {"node": "regression", "port": "out"}, "to": {"node": "postmortem", "port": "in"}},
    {"id": "i8", "from": {"node": "postmortem", "port": "out"}, "to": {"node": "monitor", "port": "in"}},
    {"id": "i9", "from": {"node": "monitor", "port": "loop"}, "to": {"node": "detect", "port": "loop"}, "route": [[200, 740], [200, 400], [50, 400], [50, 290]], "label": "new signal", "label_at": [125, 400], "label_width": 100}
  ],
  "validation": {"no_overlaps": true, "route_around_nodes": true, "min_text_padding": 16, "min_connector_clearance": 8, "verify_port_attachment": true, "verify_contrast": true}
}
